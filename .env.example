# Neon Database
# Get your connection string from: https://console.neon.tech
# Prefer the "Pooled connection" (recommended for Vercel/serverless).
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# API Key for ESP device ingestion
# Generate any random string, e.g. with: openssl rand -hex 32
INGEST_API_KEY=your-ingest-api-key

# Optional: Dashboard time zone (default: America/Santiago)
NEXT_PUBLIC_DASHBOARD_TIME_ZONE=America/Santiago
