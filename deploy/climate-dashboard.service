[Unit]
Description=Climate Monitor dashboard
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=peter
WorkingDirectory=/opt/climate-dashboard
EnvironmentFile=/etc/climate-dashboard.env
ExecStart=__NODE_BIN__ /opt/climate-dashboard/node_modules/.bin/next start --hostname 0.0.0.0
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
